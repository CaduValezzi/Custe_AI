# Make `npm ci` resilient to flaky registry connections.
# Defaults are 2 retries with short timeouts — not enough for a dropped
# TCP connection mid-download, which surfaces as "ECONNRESET" in Docker builds.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# Fewer parallel sockets than the default 16 → less TLS-handshake pressure on
# flaky/vPN'd connections, so a single reset doesn't cascade.
network-concurrency=8

